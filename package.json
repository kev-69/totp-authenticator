{
  "name": "totp-authenticator",
  "version": "0.1.0",
  "description": "RFC 4226 / RFC 6238 one-time password engine with an Express MFA demo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/app.ts",
    "cli": "tsx src/cli.ts",
    "bench": "tsx bench/run.ts",
    "attack:demo": "tsx attack/bruteforce.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "autocannon": "^8.0.0",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
